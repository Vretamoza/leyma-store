---
import Admin from '../../layouts/Admin.astro';
import CategoriesFaqs from '../../features/admin/CategoriesFaqs';

const supabase = Astro.locals.supabase!;
const [cats, faqs, brands, types] = await Promise.all([
  supabase.from('categories').select('id, name, slug, parent_id, sort_order, is_active').order('sort_order'),
  supabase
    .from('faqs')
    .select('id, question, answer, sort_order, is_active')
    .is('product_id', null)
    .order('sort_order'),
  supabase.from('brands').select('id, name').order('name'),
  supabase.from('product_types').select('id, name').order('name'),
]);
---

<Admin title="Categorías y FAQs" current="categorias">
  <CategoriesFaqs client:load categories={cats.data ?? []} faqs={faqs.data ?? []} brands={brands.data ?? []} types={types.data ?? []} />
</Admin>
