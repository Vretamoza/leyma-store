---
import Admin from '../../../layouts/Admin.astro';
import ProductEditor from '../../../features/admin/ProductEditor';

const { id } = Astro.params;
const supabase = Astro.locals.supabase!;
const isNew = id === 'nuevo';
const uuid = /^[0-9a-f-]{36}$/i;
if (!isNew && !(id && uuid.test(id))) return Astro.redirect('/admin/productos');

const [cats, brandRows, typeRows, prod] = await Promise.all([
  supabase.from('categories').select('id, name, parent_id').order('sort_order'),
  supabase.from('brands').select('id, name').order('name'),
  supabase.from('product_types').select('id, name').order('name'),
  isNew
    ? Promise.resolve({ data: null })
    : supabase
        .from('products')
        .select('*, product_variants(*), product_images(id, variant_id, path, alt, sort_order)')
        .eq('id', id!)
        .maybeSingle(),
]);
if (!isNew && !prod.data) return Astro.redirect('/admin/productos');
---

<Admin title={isNew ? 'Nuevo producto' : 'Editar producto'} current="productos">
  <ProductEditor
    client:load
    product={prod.data}
    categories={cats.data ?? []}
    brands={brandRows.data ?? []}
    types={typeRows.data ?? []}
    supabaseUrl={import.meta.env.PUBLIC_SUPABASE_URL}
  />
</Admin>
