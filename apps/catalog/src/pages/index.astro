---
import { categoryTreeIds, sortProducts, isNew } from '@leyma/core';
import Base from '../layouts/Base.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { loadCatalog, lowStockLimit } from '../lib/data';

export const prerender = false;

const { categories, products, kitSizes, settings } = await loadCatalog();
const roots = categories.filter((c) => !c.parent_id);

const productsIn = (id: string) => {
  const ids = new Set(categoryTreeIds(categories, id));
  return products.filter((p) => p.category_id && ids.has(p.category_id));
};

// Solo categorías con productos; la miniatura rota entre la foto principal de cada producto.
const MAX_SLIDES = 8;
const tiles = roots
  .map((c) => {
    const inCat = productsIn(c.id);
    const images = inCat
      .map((p) => [...p.product_images].sort((a, b) => a.sort_order - b.sort_order)[0])
      .filter(Boolean)
      .slice(0, MAX_SLIDES);
    return { category: c, count: inCat.length, images };
  })
  .filter((t) => t.count > 0);

const newest = sortProducts(products, 'novedades');
const novedades = newest.filter((p) => isNew(p.created_at, settings.new_badge_days)).slice(0, 8);
const destacados = products.filter((p) => p.is_featured).slice(0, 8);
const common = { categories, kitSizes, lowStock: lowStockLimit(settings), newDays: settings.new_badge_days };

const heroSlides = [
  { src: '/hero/belleza-rosados.webp', mobileSrc: '/hero/belleza-rosados-mobile.webp', alt: 'Tu belleza, tus reglas. Explora nuestra colección de maquillaje', href: roots[0] ? `/c/${roots[0].slug}` : '/' },
];

const steps = [
  { title: 'Elige', text: 'Mira fotos, tonos y disponibilidad en cada ficha.' },
  { title: 'Agrega a tu bolsa', text: 'Ajusta tono y cantidad. Ves el total al instante.' },
  { title: 'Envía por WhatsApp', text: 'El mensaje sale escrito. Confirmamos envío y pago contigo.' },
];
const h2 = 'font-serif text-[30px] font-semibold md:text-[44px]';
---

<Base
  title={`${settings.store_name} · Maquillaje, kits y accesorios`}
  description="Maquillaje, kits y detalles que se notan. Arma tu bolsa y envíanos el pedido por WhatsApp."
  {categories}
  {settings}
>
  <h1 class="sr-only">{settings.store_name}: maquillaje, kits y accesorios</h1>
  <HeroCarousel slides={heroSlides} />

  <main class="mx-auto max-w-[1280px] px-4 md:px-8">
    <section aria-labelledby="cat-h" class="pt-11 md:pt-24">
      <h2 id="cat-h" class:list={[h2, 'mb-4 md:mb-6']}>Categorías</h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] md:gap-6">
        {tiles.map(({ category: c, count, images }) => (
          <a href={`/c/${c.slug}`} class="overflow-hidden rounded-xl border border-line bg-surface text-ink no-underline">
            <div class="aspect-square overflow-hidden bg-ph">
              <CategoryCarousel images={images} label={c.name} />
            </div>
            <div class="flex items-center justify-between gap-2 px-3 pb-3.5 pt-3 md:px-[18px] md:py-4">
              <span class="text-[15px] font-medium md:text-[17px]">{c.name}</span>
              <span class="hidden text-[13px] text-muted md:inline">{count} {count === 1 ? 'producto' : 'productos'}</span>
              <svg class="md:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#A55A6D" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    {novedades.length > 0 && (
      <section aria-labelledby="nov-h" class="pt-11 md:pt-24">
        <div class="mb-4 flex items-baseline justify-between md:mb-6">
          <h2 id="nov-h" class={h2}>Novedades</h2>
        </div>
        <ProductGrid products={novedades} {...common} />
      </section>
    )}

    {destacados.length > 0 && (
      <section aria-labelledby="des-h" class="pt-11 md:pt-24">
        <div class="mb-4 flex items-baseline justify-between md:mb-6">
          <h2 id="des-h" class={h2}>Destacados</h2>
        </div>
        <ProductGrid products={destacados} {...common} />
      </section>
    )}

    <section id="como-pedir" aria-labelledby="como-h" class="mt-12 rounded-xl bg-primary px-5 py-7 text-bg md:mt-24 md:px-12 md:py-14">
      <h2 id="como-h" class:list={[h2, 'text-center']}>Cómo pedir</h2>
      <p class="mb-5 mt-1.5 text-center text-sm text-bg/75">Sin registro y sin pagos en la página</p>
      <ol class="m-0 grid list-none gap-4 p-0 md:grid-cols-3 md:gap-6">
        {steps.map((s, i) => (
          <li class="flex items-start gap-4 rounded-xl bg-surface p-4 text-ink md:p-6">
            <span class="w-6 font-serif text-[34px] leading-none text-gold-ink">{i + 1}</span>
            <div>
              <p class="text-[15px] font-semibold">{s.title}</p>
              <p class="mt-1 text-sm leading-normal text-muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
