---
import type { Category, CatalogFilters, Product, SortKey } from '@leyma/core';
import { activeFilterCount, formatCOP } from '@leyma/core';
import FilterForm from './FilterForm.astro';
import ProductGrid from './ProductGrid.astro';

interface Props {
  title: string;
  /** Cuántos productos tiene la vista antes de aplicar filtros. */
  total: number;
  products: Product[];
  categories: Category[];
  kitSizes: Record<string, number>;
  lowStock: number;
  newDays: number;
  subcategories: { name: string; slug: string; count: number }[];
  filters: CatalogFilters;
  sort: SortKey;
  showUndertone: boolean;
  action: string;
  query?: string;
  crumb?: string;
}
const { title, total, products, categories, kitSizes, lowStock, newDays, subcategories, filters, sort, showUndertone, action, query, crumb } = Astro.props;

const url = Astro.url;
const count = activeFilterCount(filters);
const sortLabels: Record<SortKey, string> = { novedades: 'Novedades', menor: 'Menor precio', mayor: 'Mayor precio', pedidos: 'Más pedidos' };

/** Enlace a esta misma vista sin un valor concreto de un parámetro. */
function without(key: string | string[], value?: string): string {
  const next = new URLSearchParams(url.search);
  const keys = Array.isArray(key) ? key : [key];
  for (const k of keys) {
    if (value === undefined) next.delete(k);
    else {
      const rest = next.getAll(k).filter((v) => v !== value);
      next.delete(k);
      rest.forEach((v) => next.append(k, v));
    }
  }
  const qs = next.toString();
  return action + (qs ? `?${qs}` : '');
}

const chips: { label: string; href: string }[] = [
  ...filters.subcategories.map((s) => ({ label: subcategories.find((x) => x.slug === s)?.name ?? s, href: without('sub', s) })),
  ...filters.undertones.map((t) => ({ label: `Subtono ${t}`, href: without('subtono', t) })),
  ...(filters.onlyAvailable ? [{ label: 'Disponible', href: without('disponible') }] : []),
  ...(filters.minPrice !== null || filters.maxPrice !== null
    ? [{
        label: `${filters.minPrice !== null ? formatCOP(filters.minPrice) : 'Hasta'}${filters.minPrice !== null && filters.maxPrice !== null ? ' – ' : ''}${filters.maxPrice !== null ? (filters.minPrice !== null ? '' : ' ') + formatCOP(filters.maxPrice) : '+'}`,
        href: without(['min', 'max']),
      }]
    : []),
];

const hasFilters = count > 0;
const countText = hasFilters ? `${products.length} de ${total} productos` : `${total} ${total === 1 ? 'producto' : 'productos'}`;
const sheetId = 'filters-sheet';
const chipBase = 'flex h-9 shrink-0 items-center rounded-full px-4 text-[13px] no-underline';
---

<main class="mx-auto max-w-[1280px] px-4 pb-10 pt-5 md:px-8 md:pb-20 md:pt-8">
  {crumb && (
    <nav aria-label="Ruta" class="hidden text-[13px] text-muted md:block">
      <a href="/" class="text-muted no-underline">Inicio</a> / <span class="text-ink">{crumb}</span>
    </nav>
  )}
  <div class="flex flex-wrap items-end justify-between gap-4 md:mt-3">
    <div>
      <h1 class="font-serif text-[38px] font-semibold leading-none md:text-[56px]">{title}</h1>
      <p class="mt-1.5 text-sm text-muted md:mt-2 md:text-[15px]">{countText}</p>
    </div>
    <form method="get" action={action} data-autosubmit class="hidden items-center gap-2.5 text-sm text-muted md:flex">
      {[...url.searchParams.entries()].filter(([k]) => k !== 'orden').map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <label for="orden-desktop">Ordenar por</label>
      <select id="orden-desktop" name="orden" class="h-11 rounded-full border border-outline bg-surface px-4 text-sm text-ink">
        {(Object.keys(sortLabels) as SortKey[]).map((k) => <option value={k} selected={k === sort}>{sortLabels[k]}</option>)}
      </select>
      <noscript><button type="submit" class="h-11 rounded-full bg-primary px-4 text-sm font-semibold text-bg">Ordenar</button></noscript>
    </form>
  </div>

  {subcategories.length > 0 && (
    <nav aria-label="Subcategorías" class="-mx-4 mt-4 flex gap-2 overflow-x-auto px-4 md:hidden">
      <a href={without('sub')} aria-current={filters.subcategories.length === 0 ? 'page' : undefined}
        class:list={[chipBase, filters.subcategories.length === 0 ? 'bg-ink font-medium text-bg' : 'border border-line bg-surface text-ink']}>Todo</a>
      {subcategories.map((s) => (
        <a href={`${action}?sub=${s.slug}`} aria-current={filters.subcategories.includes(s.slug) ? 'page' : undefined}
          class:list={[chipBase, filters.subcategories.includes(s.slug) ? 'bg-ink font-medium text-bg' : 'border border-line bg-surface text-ink']}>{s.name}</a>
      ))}
    </nav>
  )}

  <!-- Barra móvil: abre el drawer de filtros y orden -->
  <div class="sticky top-0 z-10 -mx-4 mt-4 flex gap-2.5 border-y border-line bg-bg px-4 py-2.5 md:hidden">
    <button type="button" data-open={sheetId} class="flex h-11 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border border-outline bg-surface text-sm font-medium text-ink">
      Filtrar
      {count > 0 && <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-tint px-1.5 text-xs font-semibold text-primary">{count}</span>}
    </button>
    <button type="button" data-open={sheetId} class="flex h-11 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border border-outline bg-surface text-sm font-medium text-ink">{sortLabels[sort]}</button>
  </div>

  {chips.length > 0 && (
    <div class="mt-3 flex flex-wrap items-center gap-2">
      {chips.map((c) => (
        <a href={c.href} aria-label={`Quitar filtro ${c.label}`} class="inline-flex h-8 items-center gap-1.5 rounded-full border border-secondary bg-tint px-3 text-[13px] text-ink no-underline">
          {c.label}<span aria-hidden="true">×</span>
        </a>
      ))}
      <a href={without(['sub', 'min', 'max', 'disponible', 'subtono'])} class="px-1.5 text-[13px] font-semibold text-primary underline">Limpiar</a>
    </div>
  )}

  <div class="mt-5 flex flex-wrap items-start gap-10 md:mt-7">
    <aside aria-label="Filtros" class="hidden max-w-[260px] flex-1 basis-60 md:block">
      <div class="flex items-center justify-between border-b border-line pb-3.5">
        <span class="text-[15px] font-semibold">Filtros{count > 0 ? ` (${count})` : ''}</span>
        {count > 0 && <a href={without(['sub', 'min', 'max', 'disponible', 'subtono'])} class="text-[13px] font-semibold text-primary underline">Limpiar</a>}
      </div>
      <FilterForm {action} idPrefix="side" {subcategories} {filters} {sort} {showUndertone} variant="sidebar" {query} />
    </aside>

    <div class="min-w-0 flex-[999_1_560px]">
      {products.length > 0 ? (
        <ProductGrid {products} {categories} {kitSizes} {lowStock} {newDays} />
      ) : (
        <div class="rounded-xl border border-line bg-surface p-8 text-center">
          <p class="font-serif text-2xl font-semibold">No encontramos productos</p>
          <p class="mt-2 text-sm text-muted">{hasFilters ? 'Prueba quitando algún filtro.' : 'Pronto tendremos novedades.'}</p>
          {hasFilters && <a href={without(['sub', 'min', 'max', 'disponible', 'subtono'])} class="mt-4 inline-flex h-11 items-center rounded-full bg-primary px-6 text-sm font-semibold text-bg no-underline">Limpiar filtros</a>}
        </div>
      )}
    </div>
  </div>
</main>

<dialog id={sheetId} class="sheet md:hidden" aria-labelledby="filters-title">
  <div class="flex max-h-[92dvh] flex-col">
    <div class="flex justify-center pt-2.5"><span class="h-1 w-10 rounded-sm bg-line"></span></div>
    <div class="flex items-center justify-between border-b border-line py-2 pl-5 pr-2">
      <h2 id="filters-title" class="font-serif text-[26px] font-semibold">Filtrar y ordenar</h2>
      <button type="button" data-close aria-label="Cerrar" class="flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent text-ink">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <FilterForm {action} idPrefix="sheet" {subcategories} {filters} {sort} {showUndertone} variant="sheet" {query} />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.getElementById(btn.dataset.open ?? '')?.dispatchEvent(new Event('open-sheet'));
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.sheet').forEach((dlg) => {
    dlg.addEventListener('open-sheet', () => dlg.showModal());
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
  document.querySelectorAll<HTMLFormElement>('form[data-autosubmit]').forEach((form) => {
    form.addEventListener('change', () => form.requestSubmit());
  });
</script>
